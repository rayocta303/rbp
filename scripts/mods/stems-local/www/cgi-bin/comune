#!/bin/sh
# Funzioni comuni ai CGI di stems-local (busybox sh).
USB=$(cat /tmp/stems-local/usb 2>/dev/null)
CODA=$USB/RX3_RUNTIME/stems-local/coda
OUTDIR=$USB/RX3_STEMS
param() { busybox httpd -d "$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1)" 2>/dev/null; }
risposta() { printf 'Status: %s\r\nContent-Type: text/plain\r\n\r\n%s\n' "$1" "$2"; exit 0; }
nome_valido() { case $1 in ''|*/*|.*|*..*) return 1 ;; esac
    [ -z "$(printf '%s' "$1" | tr -d 'A-Za-z0-9._ -')" ]; }
richiesta() {   # $1 nome della richiesta -> percorso del brano sulla chiavetta
    nome_valido "$1" && case $1 in *.req) ;; *) return 1 ;; esac || return 1
    [ -f "$CODA/$1" ] || return 1
    f=$(sed -n 's/^file=//p' "$CODA/$1" | head -1)
    case $f in /*) ;; *) return 1 ;; esac
    case $f in *..*) return 1 ;; esac
    [ -f "$USB$f" ] && printf '%s' "$USB$f"
}
